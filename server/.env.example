# Сервер
PORT=3001

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=messenger_user
PG_PASSWORD=your_secure_password
PG_DATABASE=messenger

# JWT
JWT_SECRET=your-secure-random-string-change-this

# Active Directory / LDAP Configuration (опционально)
# Без LDAP работает локальная регистрация (bcrypt)
LDAP_URL=ldap://your-ad-server:389
LDAP_BIND_DN=CN=ServiceAccount,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=service-account-password
LDAP_SEARCH_BASE=DC=example,DC=com
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_TLS_REJECT_UNAUTHORIZED=true

# Секрет для загрузки файлов обновлений (.exe, latest.yml)
UPDATE_SECRET=change-this-update-secret
